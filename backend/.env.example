# OpenClaw Dashboard — Environment Variables
# Copy this file to .env and adjust values for your setup.

# Path to your OpenClaw installation directory
OPENCLAW_DASH_OPENCLAW_DIR=/home/your-user/.openclaw

# Gateway URL (for AI chat proxy)
OPENCLAW_DASH_GATEWAY_URL=http://localhost:18789
OPENCLAW_DASH_GATEWAY_WS_URL=ws://127.0.0.1:18789
OPENCLAW_DASH_GATEWAY_TOKEN=

# Dashboard access token. The dashboard exposes a file explorer and control APIs,
# so DO NOT expose it on a public interface without one. When set, every /api and
# /ws request must present it (X-Dashboard-Token header, Authorization: Bearer, or
# ?token= on the websocket). Leave empty ONLY when bound to 127.0.0.1 (loopback).
OPENCLAW_DASH_DASHBOARD_TOKEN=

# Server settings
# Bind loopback by default. To reach it remotely, prefer an SSH tunnel to 127.0.0.1.
# Only set 0.0.0.0 together with a DASHBOARD_TOKEN above.
OPENCLAW_DASH_HOST=127.0.0.1
OPENCLAW_DASH_PORT=8765
OPENCLAW_DASH_LOG_LEVEL=info

# How often (seconds) the discovery engine re-scans your workspace
OPENCLAW_DASH_DISCOVERY_INTERVAL_SECONDS=300
